E := [0, 1, 33.4; 0, 2, 36.1; 0, 7, 22.4; 0, 6, 25.0; 1, 2, 63.5; 1, 3, 32.3; 1, 4, 44.2; 1, 6, 38.6; 2, 3, 65.2; 2, 7, 40.0; 2, 8, 47.2; 2, 9, 31.6; 3, 4, 66.7; 4, 6, 61.8; 4, 5, 85.6; 5, 6, 35.4; 5, 7, 40.3; 5, 8, 44.7; 5, 10, 33.0; 6, 7, 25.0; 7, 8, 25.0; 8, 9, 30.4; 8, 10, 42.1; 9, 10, 70.5]
