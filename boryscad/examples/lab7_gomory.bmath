@title ЛР 7 — Задача дискретного програмування
# Лабораторна робота № 7. Метод Гоморі
> Варіант 10: F = 2x₁ + 3x₂ → max; 2x₁ + 2x₂ ≥ 1; 4x₁ − 2x₂ ≤ 15; x₁ + 3x₂ ≤ 16; xⱼ ≥ 0, цілі.

c := [2, 3]
A := [2, 2; 4, -2; 1, 3]
b := [1, 15, 16]

g := gomory(c, A, b, signs=[">=", "<=", "<="])
g =

## Перевірка блоком given (цілочисельний розв’язок)
x1 := 0
x2 := 0
given
2*x1 + 2*x2 >= 1
4*x1 - 2*x2 <= 15
x1 + 3*x2 <= 16
x1 >= 0
x2 >= 0
F(x1, x2) := 2*x1 + 3*x2
maximize(F, x1, x2, integer=1) =

@plot title="Область і цілі точки" x=-0.5..6 y=-0.5..6 width=520 height=400
region(2*u + 2*v >= 1 and 4*u - 2*v <= 15 and u + 3*v <= 16 and u >= 0 and v >= 0, u, -1, 7, v, -1, 7, label="ОДР")
scatter([g.x_lp[0]], [g.x_lp[1]], color="orange", size=70, label="розв’язок ЗЛП")
scatter([g.x[0]], [g.x[1]], color="red", size=90, label="цілочисельний оптимум")
@end
