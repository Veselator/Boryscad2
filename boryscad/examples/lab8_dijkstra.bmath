@title ЛР 8 — Оптимальна траєкторія в мережі
# Лабораторна робота № 8. Алгоритм Дейкстри
> Мережа 5×5 (рис. 3). Вершини нумеруються по рядках: 1…5 — верхній ряд (К = 5), 21…25 — нижній (П = 21).

N := 5
k := 2
A := sqrt(k*N + 10)
A =

node(r, c) := r*5 + c + 1
H := [4, 2, 10, 2*A; 9, A, 4, 9; 9, 2, A/2, A; A, 4, 7, 5; 8, A + 5, 10, 7]
V := [2*A, A/2, 3, 7, A/2; 7, A + 1, 5, A - 1, A/2; 6, A - 1, 3*A, 4, A + 1; 5, 3, A, 2*A, A/2]

E := {
  e <- zeros(40, 3)
  m <- 0
  for r in 0..4 {
    for c in 0..3 {
      e[m, 0] <- node(r, c); e[m, 1] <- node(r, c + 1); e[m, 2] <- H[r, c]
      m <- m + 1
    }
  }
  for r in 0..3 {
    for c in 0..4 {
      e[m, 0] <- node(r, c); e[m, 1] <- node(r + 1, c); e[m, 2] <- V[r, c]
      m <- m + 1
    }
  }
  e
}
g(i, j) := if(j == 0, mod(i, 5), -floor(i/5))
P := matrix(25, 2, g)

d := dijkstra(E, 5, 21)
d =

@plot title="Оптимальна траєкторія К → П" width=560 height=460 legend=0
graph(E, pos=P, path=d.path)
@end

> **Загальні витрати на траєкторію:** {{d.cost}}.
